+
+bool QueueUniqueLocked(Plan plan)
+{
+  NormalizePlan(plan);
+  if (plan.mutations.empty() || !s_state.known_plan_labels.insert(plan.label).second)
+    return false;
+  s_state.queue.push_back(std::move(plan));
+  return true;
+}
+
+void BuildValidationQueueLocked()
+{
+  Plan first = MakePlan(0, std::initializer_list<Mutation>{});
+  first.label = "BASELINE_A";
+  Plan second = MakePlan(0, std::initializer_list<Mutation>{});
+  second.label = "BASELINE_B";
+  s_state.queue.push_back(std::move(first));
+  s_state.queue.push_back(std::move(second));
+}
+
+void BuildCalibrationQueueLocked()
+{
+  struct Probe
+  {
+    MutationKind kind;
+    u8 duration;
+    int amount;
+  };
+
+  static constexpr Probe probes[] = {
+      {MutationKind::StickXDelta, 1, -64},  {MutationKind::StickXDelta, 1, -32},
+      {MutationKind::StickXDelta, 1, 32},   {MutationKind::StickXDelta, 1, 64},
+      {MutationKind::StickYDelta, 1, -32},  {MutationKind::StickYDelta, 1, 16},
+      {MutationKind::StickYDelta, 1, 32},   {MutationKind::StickYCenter, 1, 0},
+      {MutationKind::CStickXDelta, 1, -64}, {MutationKind::CStickXDelta, 1, 64},
+      {MutationKind::CStickYDelta, 1, -64}, {MutationKind::CStickYDelta, 1, 64},
+      {MutationKind::LOn, 1, 0},            {MutationKind::ROn, 1, 0},
+      {MutationKind::BOff, 1, 0},
+  };
+
+  for (u16 slot = WINDOW_FIRST; slot <= s_state.effective_window_last; slot += 2)
+  {
+    for (const Probe& probe : probes)
+    {
+      QueueUniqueLocked(
+          MakePlan(1, {MakeMutation(slot, probe.kind, probe.duration, probe.amount)}));
+    }
+  }
+  s_state.calibration_built = true;
+}
+
+void RecordCoverageLocked(const Plan& plan, Outcome& outcome)
+{
+  for (const DropEvent& event : outcome.events)
+  {
+    if (event.gate_seen)
+      s_state.seen_gate_seeds.insert(event.gate_seed);
+    if (event.route_seen)
+      s_state.seen_route_seeds.insert(event.route_seed);
+    if (event.grenade_seen)
+      s_state.seen_grenade_ids.insert(event.grenade_id);
+    if (IsMoney(event))
+      s_state.seen_money_units.insert(event.late_r29);
+  }
+
+  outcome.novel_signature = s_state.seen_signatures.insert(Signature(outcome)).second;
+  if ((s_state.corpus.empty() || outcome.novel_signature || outcome.has_hand ||
+       outcome.has_9900) &&
+      s_state.corpus.size() < MAX_CORPUS_ENTRIES)
+  {
+    s_state.corpus.push_back({plan, outcome});
+  }
+
+  if (outcome.has_hand && !outcome.target)
+  {
+    ++s_state.partial_hand_attempts;
+    if (s_state.hand_corpus.size() < MAX_PARTIAL_ENTRIES)
+      s_state.hand_corpus.push_back({plan, outcome});
+  }
+  if (outcome.has_9900 && !outcome.target)
+  {
+    ++s_state.partial_9900_attempts;
+    if (s_state.money_corpus.size() < MAX_PARTIAL_ENTRIES)
+      s_state.money_corpus.push_back({plan, outcome});
+  }
+}
+
+u64 NextRandomLocked()
+{
+  u64 x = s_state.rng_state;
+  x ^= x >> 12;
+  x ^= x << 25;
+  x ^= x >> 27;
+  s_state.rng_state = x;
+  return x * 0x2545F4914F6CDD1DULL;
+}
+
+size_t RandomIndexLocked(size_t count)
+{
+  return count == 0 ? 0 : static_cast<size_t>(NextRandomLocked() % count);
+}
+
+bool ChanceLocked(u32 percent)
+{
+  return RandomIndexLocked(100) < percent;
+}
+
+u8 RandomDurationLocked()
+{
+  const size_t roll = RandomIndexLocked(100);
+  if (roll < 50)
+    return 1;
+  if (roll < 78)
+    return 2;
+  if (roll < 90)
+    return 3;
+  if (roll < 97)
+    return 4;
+  return 6;
+}
+
+u16 RandomSlotLocked(const Plan* local_parent)
+{
+  int slot = WINDOW_FIRST;
+  if (local_parent && !local_parent->mutations.empty() && ChanceLocked(55))
+  {
+    const Mutation& anchor =
+        local_parent->mutations[RandomIndexLocked(local_parent->mutations.size())];
+    slot = static_cast<int>(anchor.slot) + (static_cast<int>(RandomIndexLocked(9)) - 4) * 2;
+  }
+  else if (ChanceLocked(45))
+  {
+    const size_t tail_slots =
+        std::min<size_t>(16, (s_state.effective_window_last - WINDOW_FIRST) / 2 + 1);
+    slot = static_cast<int>(s_state.effective_window_last - 2 * RandomIndexLocked(tail_slots));
+  }
+  else
+  {
+    slot = static_cast<int>(WINDOW_FIRST +
+                            2 * RandomIndexLocked(
+                                    (s_state.effective_window_last - WINDOW_FIRST) / 2 + 1));
+  }
+  return static_cast<u16>(std::clamp<int>(slot, WINDOW_FIRST, s_state.effective_window_last));
+}
+
+Mutation RandomMutationLocked(const Plan* local_parent)
+{
+  static constexpr MutationKind weighted_kinds[] = {
+      MutationKind::BOff,         MutationKind::BOff,         MutationKind::LOn,
+      MutationKind::LOn,          MutationKind::ROn,          MutationKind::ROn,
+      MutationKind::StickXDelta,  MutationKind::StickXDelta,  MutationKind::StickXDelta,
+      MutationKind::StickYDelta,  MutationKind::StickYDelta,  MutationKind::StickYCenter,
+      MutationKind::CStickXDelta, MutationKind::CStickXDelta, MutationKind::CStickYDelta,
+      MutationKind::CStickYDelta};
+  static constexpr int main_amounts[] = {-96, -64, -32, -16, 16, 32, 64, 96};
+  static constexpr int y_amounts[] = {-64, -32, -16, 16, 32};
+
+  const MutationKind kind = weighted_kinds[RandomIndexLocked(std::size(weighted_kinds))];
+  int amount = 0;
+  if (kind == MutationKind::StickYDelta)
+    amount = y_amounts[RandomIndexLocked(std::size(y_amounts))];
+  else if (kind == MutationKind::StickXDelta || kind == MutationKind::CStickXDelta ||
+           kind == MutationKind::CStickYDelta)
+    amount = main_amounts[RandomIndexLocked(std::size(main_amounts))];
+  return MakeMutation(RandomSlotLocked(local_parent), kind, RandomDurationLocked(), amount);
+}
+
+bool AddRandomMutationLocked(Plan& plan, const Plan* local_parent)
+{
+  if (plan.mutations.size() >= MAX_PLAN_MUTATIONS)
+    return false;
+  for (int attempt = 0; attempt < 48; ++attempt)
+  {
+    const Mutation mutation = RandomMutationLocked(local_parent);
+    if (std::all_of(plan.mutations.begin(), plan.mutations.end(),
+                    [&](const Mutation& existing) { return Compatible(existing, mutation); }))
+    {
+      plan.mutations.push_back(mutation);
+      NormalizePlan(plan);
+      return !plan.mutations.empty();
+    }
+  }
+  return false;
+}
+
+Plan SelectParentLocked()
+{
+  const size_t roll = RandomIndexLocked(100);
+  if (!s_state.money_corpus.empty() && roll < 45)
+    return s_state.money_corpus[RandomIndexLocked(s_state.money_corpus.size())].plan;
+  if (!s_state.hand_corpus.empty() && roll < 75)
+    return s_state.hand_corpus[RandomIndexLocked(s_state.hand_corpus.size())].plan;
+  if (!s_state.corpus.empty() && roll < 97)
+    return s_state.corpus[RandomIndexLocked(s_state.corpus.size())].plan;
+  return MakePlan(2, std::initializer_list<Mutation>{});
+}
+
+void EditPlanLocked(Plan& plan)
+{
+  if (plan.mutations.empty())
+  {
+    AddRandomMutationLocked(plan, &plan);
+    return;
+  }
+
+  Mutation& mutation = plan.mutations[RandomIndexLocked(plan.mutations.size())];
+  switch (RandomIndexLocked(4))
+  {
+  case 0:
+    mutation.slot = RandomSlotLocked(&plan);
+    break;
+  case 1:
+    mutation.duration = RandomDurationLocked();
+    break;
+  case 2:
+  {
+    const Mutation replacement = RandomMutationLocked(&plan);
+    mutation.kind = replacement.kind;
+    mutation.amount = replacement.amount;
+    break;
+  }
+  case 3:
+    if (mutation.amount != 0)
+      mutation.amount = -mutation.amount;
+    else
+      mutation.duration = static_cast<u8>(1 + RandomIndexLocked(MAX_HOLD_SLOTS));
+    break;
+  }
+  NormalizePlan(plan);
+}
+
+void SplicePlanLocked(Plan& plan)
+{
+  if (s_state.corpus.empty())
+  {
+    AddRandomMutationLocked(plan, &plan);
+    return;
+  }
+
+  const Plan& other = s_state.corpus[RandomIndexLocked(s_state.corpus.size())].plan;
+  if (other.mutations.empty())
+  {
+    AddRandomMutationLocked(plan, &plan);
+    return;
+  }
+
+  const size_t additions = 1 + RandomIndexLocked(std::min<size_t>(3, other.mutations.size()));
+  for (size_t i = 0; i < additions && plan.mutations.size() < MAX_PLAN_MUTATIONS; ++i)
+    plan.mutations.push_back(other.mutations[RandomIndexLocked(other.mutations.size())]);
+  NormalizePlan(plan);
+}
+
+bool BuildNextAdaptivePlanLocked()
+{
+  for (int generation_attempt = 0; generation_attempt < 1024; ++generation_attempt)
+  {
+    Plan parent = SelectParentLocked();
+    Plan candidate = parent;
+    candidate.phase = 2;
+    candidate.parent_label = parent.label;
+    const size_t operation = RandomIndexLocked(100);
+
+    if (operation < 14)
+    {
+      candidate.mutations.clear();
+      candidate.parent_label = "FRESH";
+      const size_t count = 1 + RandomIndexLocked(7);
+      for (size_t i = 0; i < count; ++i)
+        AddRandomMutationLocked(candidate, &candidate);
+    }
+    else if (operation < 56)
+    {
+      AddRandomMutationLocked(candidate, &parent);
+      if (ChanceLocked(25))
+        AddRandomMutationLocked(candidate, &parent);
+    }
+    else if (operation < 76)
+    {
+      EditPlanLocked(candidate);
+    }
+    else if (operation < 87)
+    {
+      if (!candidate.mutations.empty())
+      {
+        candidate.mutations.erase(candidate.mutations.begin() +
+                                  RandomIndexLocked(candidate.mutations.size()));
+      }
+    }
+    else
+    {
+      SplicePlanLocked(candidate);
+    }
+
+    if (candidate.mutations.empty())
+      AddRandomMutationLocked(candidate, &parent);
+    NormalizePlan(candidate);
+    if (!candidate.mutations.empty() &&
+        !s_state.known_plan_labels.contains(candidate.label))
+    {
+      return QueueUniqueLocked(std::move(candidate));
+    }
+  }
+  return false;
+}
+
+bool ConfigureWindowFromBaselineLocked()
+{
+  if (s_state.validation_outcomes.size() != 2)
+  {
+    s_state.validation_error = "expected two neutral validation attempts";
+    return false;
+  }
+
+  const Outcome& first = s_state.validation_outcomes[0];
+  const Outcome& second = s_state.validation_outcomes[1];
+  if (first.completed_count < 2 || second.completed_count < 2 || first.gate_count < 2 ||
+      second.gate_count < 2)
+  {
+    s_state.validation_error = fmt::format(
+        "neutral replay did not expose two complete drops (first {}/{}, second {}/{})",
+        first.gate_count, first.completed_count, second.gate_count, second.completed_count);
+    return false;
+  }
+  if (Signature(first) != Signature(second))
+  {
+    s_state.validation_error = "two neutral replays produced different drop signatures";
+    return false;
+  }
+
+  const u64 last_gate_frame =
+      std::max(first.events[0].gate_frame, first.events[1].gate_frame);
+  if (last_gate_frame < WINDOW_FIRST - 1 || last_gate_frame > WINDOW_MAX)
+  {
+    s_state.validation_error = fmt::format(
+        "last neutral drop gate was frame {}, outside supported window {}..{}", last_gate_frame,
+        WINDOW_FIRST - 1, WINDOW_MAX);
+    return false;
+  }
+
+  const u64 rounded_slot = (last_gate_frame & 1) != 0 ? last_gate_frame + 1 : last_gate_frame;
+  s_state.effective_window_last =
+      static_cast<u16>(std::clamp<u64>(rounded_slot, WINDOW_FIRST, WINDOW_MAX));
+  return true;
+}
+
+bool PrepareNextPlanLocked()
+{
+  if (s_state.attempts >= BUDGET)
+    return false;
+
+  if (s_state.queue.empty() && !s_state.validation_done)
+  {
+    if (!ConfigureWindowFromBaselineLocked())
+      return false;
+    s_state.validation_done = true;
+    OSD::AddTypedMessage(
+        OSD::MessageType::RE4RNGTrace,
+        fmt::format("RE4 DUAL validation PASSED | drops F{}/F{} | window {}-{}",
+                    s_state.validation_outcomes[0].events[0].gate_frame,
+                    s_state.validation_outcomes[0].events[1].gate_frame, WINDOW_FIRST,
+                    s_state.effective_window_last),
+        OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+    BuildCalibrationQueueLocked();
+  }
+
+  if (s_state.queue.empty() && s_state.validation_done && s_state.calibration_built)
+  {
+    s_state.adaptive_started = true;
+    if (!BuildNextAdaptivePlanLocked())
+      return false;
+  }
+
+  if (s_state.queue.empty())
+    return false;
+
+  s_state.current_plan = std::move(s_state.queue.front());
+  s_state.queue.pop_front();
+  s_state.current_outcome = Outcome{};
+  s_state.attempt_start = std::chrono::steady_clock::now();
+  return true;
+}
+
+void FinishSearchLocked(System* system, std::string_view message, u32 color)
+{
+  s_state.finished = true;
+  s_state.active = false;
+  s_suppress_trace.store(false, std::memory_order_release);
+  Config::SetCurrent(Config::MAIN_EMULATION_SPEED, s_state.previous_speed);
+  if (s_state.results)
+    s_state.results.flush();
+  WriteSummaryLocked(message);
+  OSD::AddTypedMessage(OSD::MessageType::RE4RNGTrace, std::string(message),
+                       OSD::Duration::VERY_LONG, color);
+  if (system)
+    system->GetCPU().Break();
+}
+
+void CaptureOnCPUThread(System* system)
+{
+  {
+    std::lock_guard lock{s_mutex};
+    const auto& movie = system->GetMovie();
+    if (!movie.IsPlayingInput() || movie.GetTotalFrames() != EXPECTED_MOVIE_FRAMES ||
+        movie.GetTotalInputCount() != EXPECTED_MOVIE_INPUTS)
+    {
+      s_state.previous_speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+      s_state.validation_error = fmt::format(
+          "wrong DTM (got {} frames / {} inputs; expected {} / {})", movie.GetTotalFrames(),
+          movie.GetTotalInputCount(), EXPECTED_MOVIE_FRAMES, EXPECTED_MOVIE_INPUTS);
+      FinishSearchLocked(system, "RE4 DUAL FAILED: load the supplied neutral re4-wr-tas1.dtm",
+                         OSD::Color::RED);
+      return;
+    }
+  }
+
+  auto snapshot = ::State::SaveToMemory(*system);
+  {
+    std::lock_guard lock{s_mutex};
+    if (snapshot.empty())
+    {
+      FinishSearchLocked(system, "RE4 DUAL FAILED: in-memory snapshot error", OSD::Color::RED);
+      return;
+    }
+
+    s_state.snapshot = std::move(snapshot);
+    s_state.snapshot_ready = true;
+    s_state.active = true;
+    s_state.previous_speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+    Config::SetCurrent(Config::MAIN_EMULATION_SPEED, 0.0f);
+    s_suppress_trace.store(true, std::memory_order_release);
+    OpenResultsLocked();
+    BuildValidationQueueLocked();
+    PrepareNextPlanLocked();
+    s_state.search_start = std::chrono::steady_clock::now();
+
+    OSD::AddTypedMessage(
+        OSD::MessageType::RE4RNGTrace,
+        fmt::format("RE4 DUAL SEARCH v6 START | F{} snapshot {:.1f} MiB | budget {}",
+                    CAPTURE_FRAME,
+                    static_cast<double>(s_state.snapshot.size()) / (1024.0 * 1024.0), BUDGET),
+        OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+  }
+  system->GetCPU().Continue();
+}
+
+void RestoreOnCPUThread(System* system)
+{
+  std::span<u8> snapshot;
+  {
+    std::lock_guard lock{s_mutex};
+    snapshot = std::span<u8>{s_state.snapshot};
+  }
+
+  const bool ok = ::State::LoadFromMemory(*system, snapshot);
+  {
+    std::lock_guard lock{s_mutex};
+    s_state.restore_requested = false;
+    if (!ok)
+    {
+      FinishSearchLocked(system, "RE4 DUAL FAILED: in-memory restore error", OSD::Color::RED);
+      return;
+    }
+
+    if (!PrepareNextPlanLocked())
+    {
+      if (!s_state.validation_done)
+      {
+        FinishSearchLocked(
+            system,
+            fmt::format("RE4 DUAL validation FAILED | {}", s_state.validation_error),
+            OSD::Color::RED);
+      }
+      else
+      {
+        FinishSearchLocked(
+            system,
+            fmt::format("RE4 DUAL DONE | {} attempts | Hand partials {} | 9900 partials {}",
+                        s_state.attempts, s_state.partial_hand_attempts,
+                        s_state.partial_9900_attempts),
+            OSD::Color::YELLOW);
+      }
+      return;
+    }
+  }
+  system->GetCPU().Continue();
+}
+
+void CompleteAttempt(System* system, std::string status)
+{
+  bool found = false;
+  bool request_restore = false;
+  bool announce_hand = false;
+  bool announce_money = false;
+  u64 attempts = 0;
+  double rate = 0.0;
+  std::string found_plan;
+
+  {
+    std::lock_guard lock{s_mutex};
+    if (!s_state.active || s_state.finished || s_state.restore_requested)
+      return;
+
+    UpdateTarget(s_state.current_outcome);
+    s_state.current_outcome.status = std::move(status);
+    ++s_state.attempts;
+    const double elapsed_ms = std::chrono::duration<double, std::milli>(
+                                  std::chrono::steady_clock::now() - s_state.attempt_start)
+                                  .count();
+    const u64 old_hand_count = s_state.partial_hand_attempts;
+    const u64 old_money_count = s_state.partial_9900_attempts;
+    RecordCoverageLocked(s_state.current_plan, s_state.current_outcome);
+    announce_hand = s_state.partial_hand_attempts != old_hand_count;
+    announce_money = s_state.partial_9900_attempts != old_money_count;
+    WriteResultLocked(s_state.current_plan, s_state.current_outcome, elapsed_ms);
+
+    if (!s_state.validation_done)
+      s_state.validation_outcomes.push_back(s_state.current_outcome);
+
+    if (s_state.current_outcome.target)
+    {
+      s_state.found = true;
+      found = true;
+      WriteFoundLocked();
+      found_plan = s_state.current_plan.label;
+    }
+    else
+    {
+      s_state.restore_requested = true;
+      request_restore = true;
+    }
+
+    attempts = s_state.attempts;
+    const double seconds =
+        std::chrono::duration<double>(std::chrono::steady_clock::now() - s_state.search_start)
+            .count();
+    rate = seconds > 0.0 ? static_cast<double>(attempts) / seconds : 0.0;
+
+    if (announce_money && (s_state.partial_9900_attempts <= 20 ||
+                           (s_state.partial_9900_attempts % 25) == 0))
+    {
+      OSD::AddTypedMessage(
+          OSD::MessageType::RE4RNGTrace,
+          fmt::format("RE4 PARTIAL 9900 | attempt {} | parent saved | total {}", attempts,
+                      s_state.partial_9900_attempts),
+          OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+    }
+    else if (announce_hand && (s_state.partial_hand_attempts <= 20 ||
+                               (s_state.partial_hand_attempts % 50) == 0))
+    {
+      OSD::AddTypedMessage(
+          OSD::MessageType::RE4RNGTrace,
+          fmt::format("RE4 PARTIAL HAND | attempt {} | parent saved | total {}", attempts,
+                      s_state.partial_hand_attempts),
+          OSD::Duration::VERY_LONG, OSD::Color::CYAN);
+    }
+
+    if ((attempts % 100) == 0)
+    {
+      OSD::AddTypedMessage(
+          OSD::MessageType::RE4RNGTrace,
+          fmt::format(
+              "RE4 DUAL | {} | {:.2f}/s | phase {} | cost {}/4 | corpus {} | H {} | P {}",
+              attempts, rate, s_state.current_plan.phase,
+              s_state.current_plan.movement_cost_frames, s_state.corpus.size(),
+              s_state.partial_hand_attempts, s_state.partial_9900_attempts),
+          OSD::Duration::VERY_LONG, OSD::Color::CYAN);
+    }
+  }
+
+  if (found)
+  {
+    std::lock_guard lock{s_mutex};
+    FinishSearchLocked(
+        system, fmt::format("RE4 DUAL TARGET FOUND | attempt {} | {}", attempts, found_plan),
+        OSD::Color::GREEN);
+    return;
+  }
+
+  if (request_restore)
+  {
+    system->GetCPU().AddCPUThreadJob([system] { RestoreOnCPUThread(system); });
+    system->GetCPU().Break();
+  }
+}
+
+DropEvent* ActiveDropEvent(Outcome& outcome)
+{
+  if (outcome.active_event < 0 ||
+      outcome.active_event >= static_cast<int>(outcome.events.size()))
+  {
+    return nullptr;
+  }
+  return &outcome.events[static_cast<size_t>(outcome.active_event)];
+}
+
+void CompleteDropEvent(Outcome& outcome, DropEvent& event)
+{
+  if (!event.complete)
+  {
+    event.complete = true;
+    ++outcome.completed_count;
+  }
+}
+}  // namespace
+
+void ResetSession()
+{
+  std::lock_guard lock{s_mutex};
+  if (s_state.results.is_open())
+    s_state.results.close();
+  s_state = SearchState{};
+  s_suppress_trace.store(false, std::memory_order_release);
+  OSD::AddTypedMessage(
+      OSD::MessageType::RE4RNGTrace,
+      fmt::format("RE4 dual-drop v6 armed | capture F{} | starts F{} | max cost {}f",
+                  CAPTURE_FRAME, WINDOW_FIRST - 1, MAX_MOVEMENT_COST_FRAMES),
+      OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+}
+
+void MutateMovieControllerState(u64 movie_frame, Movie::ControllerState& state)
+{
+  std::lock_guard lock{s_mutex};
+  if (!s_state.active || s_state.finished)
+    return;
+  for (const Mutation& mutation : s_state.current_plan.mutations)
+  {
+    if (IsFrameInMutation(movie_frame, mutation))
+      ApplyMutation(state, mutation);
+  }
+}
+
+void OnPadPoll(u64 movie_frame)
+{
+  bool request_capture = false;
+  bool close_attempt = false;
+  std::string close_status;
+  {
+    std::lock_guard lock{s_mutex};
+    if (s_state.armed && !s_state.capture_requested && !s_state.snapshot_ready &&
+        !s_state.finished && movie_frame >= CAPTURE_FRAME)
+    {
+      s_state.capture_requested = true;
+      request_capture = true;
+    }
+    else if (s_state.active && !s_state.restore_requested && !s_state.finished &&
+             movie_frame >= HARD_END_FRAME)
+    {
+      UpdateTarget(s_state.current_outcome);
+      close_attempt = true;
+      close_status = fmt::format("timeout_{}_gates_{}_complete", s_state.current_outcome.gate_count,
+                                 s_state.current_outcome.completed_count);
+    }
+  }
+
+  System* const system = &System::GetInstance();
+  if (request_capture)
+  {
+    system->GetCPU().AddCPUThreadJob([system] { CaptureOnCPUThread(system); });
+    system->GetCPU().Break();
+  }
+  else if (close_attempt)
+  {
+    CompleteAttempt(system, std::move(close_status));
+  }
+}
+
+bool OnDropProbe(System* system, u32 pc)
+{
+  if (!system || !s_suppress_trace.load(std::memory_order_acquire))
+    return false;
+
+  bool complete_now = false;
+  bool target = false;
+  {
+    std::lock_guard lock{s_mutex};
+    if (!s_state.active || s_state.finished)
+      return true;
+
+    Outcome& outcome = s_state.current_outcome;
+    const u16 seed = system->GetMemory().Read_U16(RE4RNGTrace::RNG_STATE_ADDRESS);
+    const u64 frame = system->GetMovie().GetCurrentFrame();
+    const auto& ppc_state = system->GetPowerPC().GetPPCState();
+
+    if (pc == GATE_PC)
+    {
+      if (DropEvent* previous = ActiveDropEvent(outcome))
+        CompleteDropEvent(outcome, *previous);
+
+      const int next_event = outcome.active_event + 1;
+      ++outcome.gate_count;
+      if (next_event >= static_cast<int>(outcome.events.size()))
+      {
+        outcome.overflow = true;
+      }
+      else
+      {
+        outcome.active_event = next_event;
+        DropEvent& event = outcome.events[static_cast<size_t>(next_event)];
+        event.gate_seen = true;
+        event.gate_frame = frame;
+        event.gate_seed = seed;
+      }
+    }
+    else if (DropEvent* event = ActiveDropEvent(outcome))
+    {
+      if (pc == ROUTE_PC)
+      {
+        event->route_seen = true;
+        event->route_seed = seed;
+      }
+      else if (pc == GRENADE_FINAL_ID_PC)
+      {
+        event->grenade_seen = true;
+        event->grenade_id = ppc_state.gpr[29];
+      }
+      else if (pc == LATE_DROP_RESULT_PC)
+      {
+        event->late_result_seen = true;
+        event->late_r31 = ppc_state.gpr[31];
+        event->late_r29 = ppc_state.gpr[29];
+      }
+      else if (pc == DROP_FINAL_RETURN_PC)
+      {
+        event->final_return_seen = true;
+        CompleteDropEvent(outcome, *event);
+      }
+    }
+
+    UpdateTarget(outcome);
+    target = outcome.target;
+    complete_now = target || outcome.completed_count >= 2;
+  }
+
+  if (complete_now)
+    CompleteAttempt(system, target ? "target" : "two_drops");
+  return true;
+}
+
+bool IsSuppressingTrace()
+{
+  return s_suppress_trace.load(std::memory_order_acquire);
+}
+
+}  // namespace Core::RE4RNGSearch
