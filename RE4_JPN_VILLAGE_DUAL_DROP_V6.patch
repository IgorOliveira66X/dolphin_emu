+                  << (outcome.novel_signature ? 1 : 0) << ',' << s_state.corpus.size() << ','
+                  << outcome.status << ',' << fmt::format("{:.3f}", elapsed_ms) << '\n';
+  if ((s_state.attempts % 100) == 0 || outcome.target)
