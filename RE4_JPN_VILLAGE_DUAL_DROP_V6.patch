+// Exact neutral movie supplied for the village double-drop search.
+constexpr u64 EXPECTED_MOVIE_FRAMES = 8089;
+constexpr u64 EXPECTED_MOVIE_INPUTS = 16173;
+constexpr u64 CAPTURE_FRAME = 7823;
+constexpr u16 WINDOW_FIRST = 7826;  // Covers emulated frames 7825 and 7826.
+constexpr u16 WINDOW_MAX = 8032;    // The neutral movie presses A beginning at frame 8033.
+constexpr u64 WALKING_LAST_FRAME = 7953;
+constexpr u64 HARD_END_FRAME = 8070;
+constexpr u64 BUDGET = 200000;
+
+constexpr u32 GATE_PC = 0x800D2794;
+constexpr u32 ROUTE_PC = 0x800D1E9C;
+constexpr u32 GRENADE_FINAL_ID_PC = 0x800D1EF0;
+constexpr u32 LATE_DROP_RESULT_PC = 0x800D2FE4;
+constexpr u32 DROP_FINAL_RETURN_PC = 0x800D2FF8;
+constexpr u32 HAND_GRENADE_ID = 1;
+constexpr u32 PTAS_ITEM_ID = 0x78;
+constexpr u32 TARGET_PTAS_UNITS = 990;  // The game stores ptas drops in units of ten.
+
+constexpr u8 MAX_HOLD_SLOTS = 6;
+constexpr size_t MAX_PLAN_MUTATIONS = 12;
+constexpr u32 MAX_MOVEMENT_COST_FRAMES = 4;
+constexpr size_t MAX_CORPUS_ENTRIES = 8192;
+constexpr size_t MAX_PARTIAL_ENTRIES = 4096;
+constexpr u64 FUZZ_SEED = 0x5245345F44524F50ULL;
+
+constexpr std::string_view RESULTS_FILENAME = "re4_jpn_village_dual_drop_results.csv";
+constexpr std::string_view FOUND_FILENAME = "re4_jpn_village_dual_drop_FOUND.txt";
+constexpr std::string_view SUMMARY_FILENAME = "re4_jpn_village_dual_drop_summary.txt";
+
+enum class MutationKind : u8
+{
+  BOff,
+  LOn,
+  ROn,
+  StickXDelta,
+  StickYDelta,
+  StickYCenter,
+  CStickXDelta,
+  CStickYDelta,
+};
+
+struct Mutation
+{
+  u16 slot = WINDOW_FIRST;
+  u8 duration = 1;
+  MutationKind kind = MutationKind::BOff;
+  int amount = 0;
+};
+
+struct Plan
+{
+  int phase = 0;
+  std::vector<Mutation> mutations;
+  std::string label;
+  std::string parent_label = "ROOT";
+  u32 movement_cost_frames = 0;
+};
+
+struct DropEvent
+{
+  bool gate_seen = false;
+  u64 gate_frame = 0;
+  u16 gate_seed = 0;
+  bool route_seen = false;
+  u16 route_seed = 0;
+  bool grenade_seen = false;
+  u32 grenade_id = 0xFFFFFFFF;
+  bool late_result_seen = false;
+  u32 late_r31 = 0xFFFFFFFF;
+  u32 late_r29 = 0xFFFFFFFF;
+  bool final_return_seen = false;
+  bool complete = false;
+};
+
+struct Outcome
+{
+  std::array<DropEvent, 2> events{};
+  int active_event = -1;
+  size_t gate_count = 0;
+  size_t completed_count = 0;
+  bool overflow = false;
+  bool has_hand = false;
+  bool has_9900 = false;
+  bool target = false;
+  bool novel_signature = false;
+  std::string status = "ok";
+};
+
+struct CorpusEntry
+{
+  Plan plan{};
+  Outcome outcome{};
+};
+
+using SignatureKey = std::array<u64, 12>;
+
+struct SearchState
+{
+  bool armed = true;
+  bool capture_requested = false;
+  bool snapshot_ready = false;
+  bool restore_requested = false;
+  bool active = false;
+  bool finished = false;
+  bool found = false;
+  bool validation_done = false;
+  bool calibration_built = false;
+  bool adaptive_started = false;
+  u64 attempts = 0;
+  u64 partial_hand_attempts = 0;
+  u64 partial_9900_attempts = 0;
+  u64 rng_state = FUZZ_SEED;
+  u16 effective_window_last = WINDOW_MAX;
+  std::vector<u8> snapshot;
+  std::deque<Plan> queue;
+  Plan current_plan{};
+  Outcome current_outcome{};
+  std::vector<Outcome> validation_outcomes;
+  std::vector<CorpusEntry> corpus;
+  std::vector<CorpusEntry> hand_corpus;
+  std::vector<CorpusEntry> money_corpus;
+  std::set<SignatureKey> seen_signatures;
+  std::set<u16> seen_gate_seeds;
+  std::set<u16> seen_route_seeds;
+  std::set<u32> seen_grenade_ids;
+  std::set<u32> seen_money_units;
+  std::unordered_set<std::string> known_plan_labels;
+  float previous_speed = 1.0f;
+  std::string validation_error;
+  std::chrono::steady_clock::time_point search_start{};
+  std::chrono::steady_clock::time_point attempt_start{};
+  std::ofstream results;
+};
+
+std::mutex s_mutex;
+std::atomic_bool s_suppress_trace{false};
+SearchState s_state;
+
+bool IsHand(const DropEvent& event)
+{
+  return event.grenade_seen && event.grenade_id == HAND_GRENADE_ID;
+}
+
+bool IsMoney(const DropEvent& event)
+{
+  return event.late_result_seen && event.late_r31 == PTAS_ITEM_ID;
+}
+
+bool Is9900(const DropEvent& event)
+{
+  return IsMoney(event) && event.late_r29 == TARGET_PTAS_UNITS;
+}
+
+std::string EventClass(const DropEvent& event)
+{
+  if (IsHand(event))
+    return "HAND";
+  if (Is9900(event))
+    return "9900_PTAS";
+  if (IsMoney(event))
+    return fmt::format("{}_PTAS", static_cast<u64>(event.late_r29) * 10);
+  if (event.grenade_seen)
+    return fmt::format("GRENADE_ID_{:X}", event.grenade_id);
+  if (event.late_result_seen)
+    return fmt::format("ITEM_{:X}_VALUE_{:X}", event.late_r31, event.late_r29);
+  return "UNKNOWN";
+}
+
+void UpdateTarget(Outcome& outcome)
+{
+  outcome.has_hand = IsHand(outcome.events[0]) || IsHand(outcome.events[1]);
+  outcome.has_9900 = Is9900(outcome.events[0]) || Is9900(outcome.events[1]);
+  outcome.target = (IsHand(outcome.events[0]) && Is9900(outcome.events[1])) ||
+                   (Is9900(outcome.events[0]) && IsHand(outcome.events[1]));
+}
+
+std::string KindName(const Mutation& mutation)
+{
+  switch (mutation.kind)
+  {
+  case MutationKind::BOff:
+    return "B_OFF";
+  case MutationKind::LOn:
+    return "L";
+  case MutationKind::ROn:
+    return "R";
+  case MutationKind::StickXDelta:
+    return fmt::format("SX{}{}", mutation.amount < 0 ? "m" : "p", std::abs(mutation.amount));
+  case MutationKind::StickYDelta:
+    return fmt::format("SY{}{}", mutation.amount < 0 ? "m" : "p", std::abs(mutation.amount));
+  case MutationKind::StickYCenter:
+    return "SY_CENTER";
+  case MutationKind::CStickXDelta:
+    return fmt::format("CX{}{}", mutation.amount < 0 ? "m" : "p", std::abs(mutation.amount));
+  case MutationKind::CStickYDelta:
+    return fmt::format("CY{}{}", mutation.amount < 0 ? "m" : "p", std::abs(mutation.amount));
+  }
+  return "?";
+}
+
+std::string MutationName(const Mutation& mutation)
+{
+  return fmt::format("F{}:{}{}", mutation.slot, KindName(mutation),
+                     mutation.duration > 1 ? fmt::format("x{}", mutation.duration) : "");
+}
+
+std::string MakePlanLabel(const std::vector<Mutation>& mutations)
+{
+  if (mutations.empty())
+    return "BASELINE";
+
+  std::string label;
+  for (const Mutation& mutation : mutations)
+  {
+    if (!label.empty())
+      label += '+';
+    label += MutationName(mutation);
+  }
+  return label;
+}
+
+enum class ControlGroup : u8
+{
+  B,
+  L,
+  R,
+  StickX,
+  StickY,
+  CStickX,
+  CStickY,
+};
+
+ControlGroup GetControlGroup(MutationKind kind)
+{
+  switch (kind)
+  {
+  case MutationKind::BOff:
+    return ControlGroup::B;
+  case MutationKind::LOn:
+    return ControlGroup::L;
+  case MutationKind::ROn:
+    return ControlGroup::R;
+  case MutationKind::StickXDelta:
+    return ControlGroup::StickX;
+  case MutationKind::StickYDelta:
+  case MutationKind::StickYCenter:
+    return ControlGroup::StickY;
+  case MutationKind::CStickXDelta:
+    return ControlGroup::CStickX;
+  case MutationKind::CStickYDelta:
+    return ControlGroup::CStickY;
+  }
+  return ControlGroup::B;
+}
+
+u16 LastSlot(const Mutation& mutation)
+{
+  return static_cast<u16>(mutation.slot + 2 * (mutation.duration - 1));
+}
+
+u64 FirstFrame(const Mutation& mutation)
+{
+  return mutation.slot - 1;
+}
+
+bool Compatible(const Mutation& a, const Mutation& b)
+{
+  if (GetControlGroup(a.kind) != GetControlGroup(b.kind))
+    return true;
+  return LastSlot(a) < b.slot || LastSlot(b) < a.slot;
+}
+
+bool CostsMovement(const Mutation& mutation)
+{
+  switch (mutation.kind)
+  {
+  case MutationKind::BOff:
+  case MutationKind::LOn:
+  case MutationKind::ROn:
+  case MutationKind::StickYCenter:
+    return true;
+  case MutationKind::StickYDelta:
+    return mutation.amount < 0;
+  default:
+    return false;
+  }
+}
+
+u32 PlanMovementCost(const std::vector<Mutation>& mutations)
+{
+  std::array<bool, WALKING_LAST_FRAME - (WINDOW_FIRST - 1) + 1> affected{};
+  for (const Mutation& mutation : mutations)
+  {
+    if (!CostsMovement(mutation))
+      continue;
+    const u64 first = std::max<u64>(FirstFrame(mutation), WINDOW_FIRST - 1);
+    const u64 last = std::min<u64>(LastSlot(mutation), WALKING_LAST_FRAME);
+    if (first > last)
+      continue;
+    for (u64 frame = first; frame <= last; ++frame)
+      affected[frame - (WINDOW_FIRST - 1)] = true;
+  }
+  return static_cast<u32>(std::count(affected.begin(), affected.end(), true));
+}
+
+bool MutationCanAffectMovie(const Mutation& mutation)
+{
+  if ((mutation.kind == MutationKind::BOff || mutation.kind == MutationKind::StickYCenter) &&
+      FirstFrame(mutation) > WALKING_LAST_FRAME)
+  {
+    return false;
+  }
+  return true;
+}
+
+void NormalizePlan(Plan& plan)
+{
+  std::vector<Mutation> prepared;
+  prepared.reserve(plan.mutations.size());
+  for (Mutation mutation : plan.mutations)
+  {
+    int slot = std::clamp<int>(mutation.slot, WINDOW_FIRST, s_state.effective_window_last);
+    slot -= (slot - static_cast<int>(WINDOW_FIRST)) & 1;
+    mutation.slot = static_cast<u16>(slot);
+    const u8 available =
+        static_cast<u8>((s_state.effective_window_last - mutation.slot) / 2 + 1);
+    mutation.duration = std::clamp<u8>(mutation.duration, 1,
+                                       std::min<u8>(MAX_HOLD_SLOTS, available));
+
+    if (mutation.kind == MutationKind::StickXDelta ||
+        mutation.kind == MutationKind::StickYDelta ||
+        mutation.kind == MutationKind::CStickXDelta ||
+        mutation.kind == MutationKind::CStickYDelta)
+    {
+      if (mutation.amount == 0)
+        mutation.amount = 32;
+      mutation.amount = std::clamp(mutation.amount, -127, 127);
+    }
+    else
+    {
+      mutation.amount = 0;
+    }
+
+    // Never introduce fresh forward/backward input after the optimized run ends.
+    if (mutation.kind == MutationKind::StickYDelta ||
+        mutation.kind == MutationKind::StickYCenter)
+    {
+      if (mutation.slot > 7952)
+        continue;
+      const u8 walking_available = static_cast<u8>((7952 - mutation.slot) / 2 + 1);
+      mutation.duration = std::min(mutation.duration, walking_available);
+    }
+
+    if (MutationCanAffectMovie(mutation))
+      prepared.push_back(mutation);
+  }
+
+  std::sort(prepared.begin(), prepared.end(), [](const Mutation& a, const Mutation& b) {
+    return std::tie(a.slot, a.kind, a.duration, a.amount) <
+           std::tie(b.slot, b.kind, b.duration, b.amount);
+  });
+
+  std::vector<Mutation> normalized;
+  normalized.reserve(std::min(prepared.size(), MAX_PLAN_MUTATIONS));
+  for (Mutation mutation : prepared)
+  {
+    const bool compatible = std::all_of(
+        normalized.begin(), normalized.end(),
+        [&](const Mutation& existing) { return Compatible(existing, mutation); });
+    if (!compatible)
+      continue;
+
+    while (mutation.duration > 1)
+    {
+      std::vector<Mutation> candidate = normalized;
+      candidate.push_back(mutation);
+      if (PlanMovementCost(candidate) <= MAX_MOVEMENT_COST_FRAMES)
+        break;
+      --mutation.duration;
+    }
+
+    std::vector<Mutation> candidate = normalized;
+    candidate.push_back(mutation);
+    if (PlanMovementCost(candidate) <= MAX_MOVEMENT_COST_FRAMES)
+      normalized.push_back(mutation);
+    if (normalized.size() >= MAX_PLAN_MUTATIONS)
+      break;
+  }
+
+  plan.mutations = std::move(normalized);
+  plan.movement_cost_frames = PlanMovementCost(plan.mutations);
+  plan.label = MakePlanLabel(plan.mutations);
+}
+
+Mutation MakeMutation(u16 slot, MutationKind kind, u8 duration = 1, int amount = 0)
+{
+  return Mutation{slot, duration, kind, amount};
+}
+
+Plan MakePlan(int phase, std::initializer_list<Mutation> mutations)
+{
+  Plan plan;
+  plan.phase = phase;
+  plan.mutations.assign(mutations.begin(), mutations.end());
+  NormalizePlan(plan);
+  return plan;
+}
+
+Plan MakePlan(int phase, std::vector<Mutation> mutations)
+{
+  Plan plan;
+  plan.phase = phase;
+  plan.mutations = std::move(mutations);
+  NormalizePlan(plan);
+  return plan;
+}
+
+bool IsFrameInMutation(u64 frame, const Mutation& mutation)
+{
+  return frame >= FirstFrame(mutation) && frame <= LastSlot(mutation);
+}
+
+u8 AddClamped(u8 value, int delta)
+{
+  return static_cast<u8>(std::clamp(static_cast<int>(value) + delta, 0, 255));
+}
+
+void ApplyMutation(Movie::ControllerState& state, const Mutation& mutation)
+{
+  switch (mutation.kind)
+  {
+  case MutationKind::BOff:
+    state.B = false;
+    break;
+  case MutationKind::LOn:
+    state.L = true;
+    state.TriggerL = 255;
+    break;
+  case MutationKind::ROn:
+    state.R = true;
+    state.TriggerR = 255;
+    break;
+  case MutationKind::StickXDelta:
+    state.AnalogStickX = AddClamped(state.AnalogStickX, mutation.amount);
+    break;
+  case MutationKind::StickYDelta:
+    state.AnalogStickY = AddClamped(state.AnalogStickY, mutation.amount);
+    break;
+  case MutationKind::StickYCenter:
+    state.AnalogStickY = 128;
+    break;
+  case MutationKind::CStickXDelta:
+    state.CStickX = AddClamped(state.CStickX, mutation.amount);
+    break;
+  case MutationKind::CStickYDelta:
+    state.CStickY = AddClamped(state.CStickY, mutation.amount);
+    break;
+  }
+}
+
+SignatureKey Signature(const Outcome& outcome)
+{
+  SignatureKey key{};
+  for (size_t i = 0; i < outcome.events.size(); ++i)
+  {
+    const DropEvent& event = outcome.events[i];
+    const size_t base = i * 6;
+    key[base] = (static_cast<u64>(event.gate_seen) << 63) | event.gate_frame;
+    key[base + 1] = (static_cast<u64>(event.gate_seed) << 32) |
+                    (static_cast<u64>(event.route_seen) << 31) | event.route_seed;
+    key[base + 2] = (static_cast<u64>(event.grenade_seen) << 63) | event.grenade_id;
+    key[base + 3] = (static_cast<u64>(event.late_result_seen) << 63) | event.late_r31;
+    key[base + 4] = event.late_r29;
+    key[base + 5] = (static_cast<u64>(event.final_return_seen) << 1) |
+                    static_cast<u64>(event.complete);
+  }
+  return key;
+}
