+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/RE4RNGBenchmark.h"
+
+#include <atomic>
+#include <chrono>
+#include <fstream>
+#include <mutex>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include "Common/Config/Config.h"
+#include "Common/FileUtil.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/HW/CPU.h"
+#include "Core/State.h"
+#include "Core/System.h"
+#include "VideoCommon/OnScreenDisplay.h"
+
+namespace Core::RE4RNGBenchmark
+{
+namespace
+{
+constexpr u64 CAPTURE_FRAME = 2858;
+constexpr u32 TARGET_PC = 0x800D2794;
+constexpr u64 MIN_ITERATIONS = 100;
+constexpr u64 MAX_ITERATIONS = 10000;
+constexpr auto MIN_WALL_TIME = std::chrono::seconds(10);
+constexpr std::string_view RESULT_FILENAME = "re4_jpn_rng_benchmark.csv";
+
+struct BenchmarkState
+{
+  bool armed = true;
+  bool capture_requested = false;
+  bool snapshot_ready = false;
+  bool restore_requested = false;
+  bool finished = false;
+  bool suppress_trace_io = false;
+  bool failed = false;
+  u64 iterations = 0;
+  u64 restore_count = 0;
+  std::vector<u8> snapshot;
+  float previous_speed = 1.0f;
+  std::chrono::steady_clock::time_point start_time{};
+  std::chrono::nanoseconds restore_time{};
+};
+
+std::mutex s_mutex;
+std::atomic_bool s_suppress_trace_io{false};
+BenchmarkState s_state;
+
+void WriteResultLocked(double total_seconds)
+{
+  File::CreateFullPath(File::GetUserPath(D_LOGS_IDX));
+  const std::string path = File::GetUserPath(D_LOGS_IDX) + std::string(RESULT_FILENAME);
+  std::ofstream out(path, std::ios::out | std::ios::trunc);
+  if (!out)
+    return;
+
+  const double total_ms = total_seconds * 1000.0;
+  const double restore_ms = std::chrono::duration<double, std::milli>(s_state.restore_time).count();
+  const double attempts_per_sec =
+      total_seconds > 0.0 ? static_cast<double>(s_state.iterations) / total_seconds : 0.0;
+  const double avg_cycle_us = s_state.iterations > 0 ?
+                                  total_seconds * 1'000'000.0 /
+                                      static_cast<double>(s_state.iterations) :
+                                  0.0;
+  const double avg_restore_us = s_state.restore_count > 0 ?
+                                    restore_ms * 1000.0 /
+                                        static_cast<double>(s_state.restore_count) :
+                                    0.0;
+  const double avg_sim_us = s_state.iterations > 0 ?
+                                ((total_ms - restore_ms) * 1000.0) /
+                                    static_cast<double>(s_state.iterations) :
+                                0.0;
+
+  out << "capture_frame,target_pc,iterations,restore_count,snapshot_bytes,total_ms,restore_ms,"
+         "attempts_per_sec,avg_cycle_us,avg_restore_us,avg_sim_us,failed\n";
+  out << fmt::format("{},${:08X},{},{},{},{:.3f},{:.3f},{:.3f},{:.3f},{:.3f},{:.3f},{}\n",
+                     CAPTURE_FRAME, TARGET_PC, s_state.iterations, s_state.restore_count,
+                     s_state.snapshot.size(), total_ms, restore_ms, attempts_per_sec, avg_cycle_us,
+                     avg_restore_us, avg_sim_us, s_state.failed ? 1 : 0);
+  out.flush();
+}
+
+void CaptureOnCPUThread(System* system)
+{
+  auto snapshot = State::SaveToMemory(*system);
+  const bool ok = !snapshot.empty();
+
+  {
+    std::lock_guard lock{s_mutex};
+    if (!ok)
+    {
+      s_state.failed = true;
+      s_state.finished = true;
+      OSD::AddTypedMessage(OSD::MessageType::RE4RNGTrace,
+                           "RE4 RNG benchmark v3 FAILED: in-memory snapshot error",
+                           OSD::Duration::VERY_LONG, OSD::Color::RED);
+      return;
+    }
+
+    s_state.snapshot = std::move(snapshot);
+    s_state.snapshot_ready = true;
+    s_state.restore_requested = false;
+    s_state.suppress_trace_io = true;
+    s_suppress_trace_io.store(true, std::memory_order_release);
+    s_state.iterations = 0;
+    s_state.restore_count = 0;
+    s_state.restore_time = std::chrono::nanoseconds::zero();
+    s_state.previous_speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+    Config::SetCurrent(Config::MAIN_EMULATION_SPEED, 0.0f);
+    s_state.start_time = std::chrono::steady_clock::now();
+
+    OSD::AddTypedMessage(
+        OSD::MessageType::RE4RNGTrace,
+        fmt::format("RE4 RNG BENCH v3 START | F{} -> ${:08X} | snapshot {:.1f} MiB | unlimited",
+                    CAPTURE_FRAME, TARGET_PC,
+                    static_cast<double>(s_state.snapshot.size()) / (1024.0 * 1024.0)),
+        OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+  }
+
+  system->GetCPU().Continue();
+}
+
+void RestoreOnCPUThread(System* system)
+{
+  std::span<u8> snapshot;
+  {
+    std::lock_guard lock{s_mutex};
+    if (!s_state.snapshot.empty())
+      snapshot = s_state.snapshot;
+  }
+
+  const auto start = std::chrono::steady_clock::now();
+  const bool ok = !snapshot.empty() && State::LoadFromMemory(*system, snapshot);
+  const auto end = std::chrono::steady_clock::now();
+
+  {
+    std::lock_guard lock{s_mutex};
+    s_state.restore_time += std::chrono::duration_cast<std::chrono::nanoseconds>(end - start);
+    ++s_state.restore_count;
+    s_state.restore_requested = false;
+
+    if (!ok)
+    {
+      s_state.failed = true;
+      s_state.finished = true;
+      s_state.suppress_trace_io = false;
+      s_suppress_trace_io.store(false, std::memory_order_release);
+      Config::SetCurrent(Config::MAIN_EMULATION_SPEED, s_state.previous_speed);
+      const auto elapsed = std::chrono::steady_clock::now() - s_state.start_time;
+      WriteResultLocked(std::chrono::duration<double>(elapsed).count());
+      OSD::AddTypedMessage(OSD::MessageType::RE4RNGTrace,
+                           "RE4 RNG benchmark v3 FAILED: in-memory restore error",
+                           OSD::Duration::VERY_LONG, OSD::Color::RED);
+      return;
+    }
+  }
+
+  system->GetCPU().Continue();
+}
+}  // namespace
+
+void ResetSession()
+{
+  std::lock_guard lock{s_mutex};
+  s_state = BenchmarkState{};
+  s_suppress_trace_io.store(false, std::memory_order_release);
+
+  OSD::AddTypedMessage(
+      OSD::MessageType::RE4RNGTrace,
+      fmt::format("RE4 RNG benchmark v3 armed | capture F{} | target ${:08X}", CAPTURE_FRAME,
+                  TARGET_PC),
+      OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+}
+
+void OnPadPoll(u64 frame)
+{
+  bool request_capture = false;
+  {
+    std::lock_guard lock{s_mutex};
+    if (s_state.armed && !s_state.capture_requested && !s_state.snapshot_ready &&
+        !s_state.finished && frame >= CAPTURE_FRAME)
+    {
+      s_state.capture_requested = true;
+      request_capture = true;
+    }
+  }
+
+  if (!request_capture)
+    return;
+
+  System* const system = &System::GetInstance();
+  system->GetCPU().AddCPUThreadJob([system] { CaptureOnCPUThread(system); });
+  system->GetCPU().Break();
+}
+
+bool OnDropProbe(System* system, u32 pc)
+{
+  if (system == nullptr || pc != TARGET_PC)
+    return false;
+
+  bool should_restore = false;
+  bool should_finish = false;
+  double total_seconds = 0.0;
+  u64 iterations = 0;
+  double attempts_per_sec = 0.0;
+  double avg_restore_us = 0.0;
+
+  {
+    std::lock_guard lock{s_mutex};
+    if (!s_state.snapshot_ready || s_state.finished || s_state.restore_requested)
+      return false;
+
+    ++s_state.iterations;
+    const auto elapsed = std::chrono::steady_clock::now() - s_state.start_time;
+    total_seconds = std::chrono::duration<double>(elapsed).count();
+
+    const bool time_limit =
+        s_state.iterations >= MIN_ITERATIONS && elapsed >= MIN_WALL_TIME;
+    const bool iteration_limit = s_state.iterations >= MAX_ITERATIONS;
+
+    if (time_limit || iteration_limit)
+    {
+      s_state.finished = true;
+      s_state.suppress_trace_io = false;
+      s_suppress_trace_io.store(false, std::memory_order_release);
+      Config::SetCurrent(Config::MAIN_EMULATION_SPEED, s_state.previous_speed);
+      WriteResultLocked(total_seconds);
+
+      iterations = s_state.iterations;
+      attempts_per_sec =
+          total_seconds > 0.0 ? static_cast<double>(iterations) / total_seconds : 0.0;
+      const double restore_ms =
+          std::chrono::duration<double, std::milli>(s_state.restore_time).count();
+      avg_restore_us = s_state.restore_count > 0 ?
+                           restore_ms * 1000.0 / static_cast<double>(s_state.restore_count) :
+                           0.0;
+      should_finish = true;
+    }
+    else
+    {
+      s_state.restore_requested = true;
+      should_restore = true;
+    }
+  }
+
+  if (should_finish)
+  {
+    OSD::AddTypedMessage(
+        OSD::MessageType::RE4RNGTrace,
+        fmt::format("RE4 RNG BENCH DONE | {} attempts | {:.2f}/s | restore {:.1f} us",
+                    iterations, attempts_per_sec, avg_restore_us),
+        OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+    system->GetCPU().Break();
+    return true;
+  }
+
+  if (should_restore)
+  {
+    system->GetCPU().AddCPUThreadJob([system] { RestoreOnCPUThread(system); });
+    system->GetCPU().Break();
+    return true;
+  }
+
+  return false;
+}
+
+bool IsSuppressingTraceIO()
+{
+  return s_suppress_trace_io.load(std::memory_order_acquire);
+}
+
+}  // namespace Core::RE4RNGBenchmark
