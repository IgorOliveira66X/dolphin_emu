+// Called after controller 1 is delivered to the movie/game. The benchmark captures once the
+// current movie reaches its configured pre-drop frame.
+void OnPadPoll(u64 frame);
+
+// Called before executing a known drop-probe PC. Returns true when the benchmark consumed the
+// event (target hit / restore / finish), so the normal drop logger can skip that probe.
+bool OnDropProbe(System* system, u32 pc);
