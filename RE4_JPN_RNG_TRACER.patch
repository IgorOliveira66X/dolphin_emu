diff --git a/Source/Core/Core/State.cpp b/Source/Core/Core/State.cpp
index 2dcd2ca..7819cca 100644
--- a/Source/Core/Core/State.cpp
+++ b/Source/Core/Core/State.cpp
@@ -258,6 +258,26 @@ static std::size_t SaveToBuffer(Core::System& system, Common::UniqueBuffer<u8>&
   return 0;
 }
 
+std::vector<u8> SaveToMemory(Core::System& system)
+{
+  const auto buffer_size_estimate = static_cast<std::size_t>(s_last_state_size) * 110 / 100;
+  Common::UniqueBuffer<u8> buffer{buffer_size_estimate};
+  const std::size_t actual_size = SaveToBuffer(system, buffer);
+  if (actual_size == 0)
+    return {};
+
+  std::vector<u8> result(actual_size);
+  std::copy_n(buffer.data(), actual_size, result.data());
+  return result;
+}
+
+bool LoadFromMemory(Core::System& system, std::span<u8> buffer)
+{
+  if (buffer.empty())
+    return false;
+  return LoadFromBuffer(system, buffer);
+}
