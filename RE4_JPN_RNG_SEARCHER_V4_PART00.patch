+enum class MutationKind : u8
+{
+  BOff,
+  LOn,
+  ROn,
+  StickXMinus,
+  StickXPlus,
+  StickYMinus,
+  StickYPlus,
+};
+
+struct Mutation
+{
+  u64 frame = 0;
+  MutationKind kind = MutationKind::BOff;
+};
+
+struct AttemptPlan
+{
+  u64 attempt_id = 0;
+  u8 phase = 0;
+  std::array<Mutation, 3> mutations{};
+  u8 mutation_count = 0;
+};
+
+struct AttemptResult
