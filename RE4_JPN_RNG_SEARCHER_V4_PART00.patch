+
+const char* MutationKindName(MutationKind kind)
+{
+  switch (kind)
+  {
+  case MutationKind::BOff:
+    return "B_OFF";
+  case MutationKind::LOn:
+    return "L_ON";
+  case MutationKind::ROn:
+    return "R_ON";
+  case MutationKind::StickXMinus:
+    return "SX-8";
+  case MutationKind::StickXPlus:
+    return "SX+8";
+  case MutationKind::StickYMinus:
+    return "SY-8";
+  case MutationKind::StickYPlus:
+    return "SY+8";
+  }
+  return "?";
+}
+
+std::string MutationText(const Mutation& mutation)
+{
+  return fmt::format("F{}:{}", mutation.frame, MutationKindName(mutation.kind));
+}
+
+std::string PlanText(const AttemptPlan& plan)
+{
+  if (plan.mutation_count == 0)
+    return "BASELINE";
+
+  std::string result;
+  for (u8 i = 0; i < plan.mutation_count; ++i)
+  {
+    if (!result.empty())
+      result += "+";
+    result += MutationText(plan.mutations[i]);
+  }
+  return result;
+}
+
+bool SameMutation(const Mutation& a, const Mutation& b)
+{
+  return a.frame == b.frame && a.kind == b.kind;
+}
+
+bool IsStickXMutation(MutationKind kind)
+{
+  return kind == MutationKind::StickXMinus || kind == MutationKind::StickXPlus;
+}
+
+bool IsStickYMutation(MutationKind kind)
+{
+  return kind == MutationKind::StickYMinus || kind == MutationKind::StickYPlus;
+}
+
+bool Compatible(const Mutation& a, const Mutation& b)
+{
+  if (SameMutation(a, b))
+    return false;
+  if (a.frame != b.frame)
+    return true;
+
+  if (IsStickXMutation(a.kind) && IsStickXMutation(b.kind))
+    return false;
+  if (IsStickYMutation(a.kind) && IsStickYMutation(b.kind))
+    return false;
+  return true;
+}
+
+bool Compatible(const Mutation& a, const Mutation& b, const Mutation& c)
+{
+  return Compatible(a, b) && Compatible(a, c) && Compatible(b, c);
+}
+
+u8 ClampAdd(u8 value, int delta)
+{
+  return static_cast<u8>(std::clamp(static_cast<int>(value) + delta, 0, 255));
+}
+
+void ApplyMutation(GCPadStatus& pad, const Mutation& mutation)
+{
+  switch (mutation.kind)
+  {
+  case MutationKind::BOff:
+    pad.button &= static_cast<u16>(~PAD_BUTTON_B);
+    pad.analogB = 0;
+    break;
+  case MutationKind::LOn:
+    pad.button |= PAD_TRIGGER_L;
+    pad.triggerLeft = 0xFF;
+    break;
+  case MutationKind::ROn:
+    pad.button |= PAD_TRIGGER_R;
+    pad.triggerRight = 0xFF;
+    break;
+  case MutationKind::StickXMinus:
+    pad.stickX = ClampAdd(pad.stickX, -8);
+    break;
+  case MutationKind::StickXPlus:
+    pad.stickX = ClampAdd(pad.stickX, 8);
+    break;
+  case MutationKind::StickYMinus:
+    pad.stickY = ClampAdd(pad.stickY, -8);
+    break;
+  case MutationKind::StickYPlus:
+    pad.stickY = ClampAdd(pad.stickY, 8);
+    break;
+  }
+}
