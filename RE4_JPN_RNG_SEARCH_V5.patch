+{
+constexpr u64 CAPTURE_FRAME = 2818;
+constexpr u64 WINDOW_FIRST = 2822;
+constexpr u64 WINDOW_LAST = 2910;
+constexpr u64 RESULT_FRAME = 2914;
+constexpr u64 HARD_END_FRAME = 2924;
+constexpr u64 BUDGET = 20000;
+constexpr u32 GATE_PC = 0x800D2794;
+constexpr u32 ROUTE_PC = 0x800D1E9C;
+constexpr u32 FINAL_ID_PC = 0x800D1EF0;
+constexpr u16 EXPECTED_BASELINE_GATE = 0x42B3;
+constexpr u16 EXPECTED_B2866_GATE = 0x47AC;
+constexpr u16 EXPECTED_LPAIR_GATE = 0xD62C;
+constexpr u16 EXPECTED_LPAIR_ROUTE = 0xBE42;
+constexpr u32 EXPECTED_LPAIR_ID = 2;
+constexpr u16 KNOWN_HAND_ROUTE = 0xBE9B;
+constexpr u32 TARGET_ITEM_ID = 1;
+constexpr u8 MAX_HOLD_SLOTS = 6;
+constexpr size_t MAX_PLAN_MUTATIONS = 8;
+constexpr size_t MAX_CORPUS_ENTRIES = 4096;
+constexpr size_t MAX_GATE_ALIASES = 3;
+constexpr size_t MAX_ROUTE_ALIASES = 24;
+constexpr u64 FUZZ_SEED = 0x5245345F56355F31ULL;
+constexpr std::string_view RESULTS_FILENAME = "re4_jpn_rng_search_results.csv";
+constexpr std::string_view FOUND_FILENAME = "re4_jpn_rng_search_FOUND.txt";
+constexpr std::string_view SUMMARY_FILENAME = "re4_jpn_rng_search_summary.txt";
+
+enum class MutationKind : u8
+{
+  BOff,
+  LOn,
+  ROn,
+  StickXDelta,
+  StickYDelta,
+  StickXCenter,
+  StickYCenter,
+};
+
+struct Mutation
+{
+  u16 slot = 0;
+  u8 duration = 1;
+  MutationKind kind = MutationKind::BOff;
+  int amount = 0;
+};
+
+struct Plan
+{
+  int phase = 0;
+  std::vector<Mutation> mutations;
+  std::string label;
+  std::string parent_label = "ROOT";
+};
+
+struct Outcome
+{
+  bool gate_seen = false;
+  u16 gate_seed = 0;
+  bool route_seen = false;
+  u16 route_seed = 0;
+  bool final_seen = false;
+  u32 final_id = 0xFFFFFFFF;
+  bool target = false;
+  bool novel_gate = false;
+  bool novel_route = false;
+  bool novel_signature = false;
+  std::string status = "ok";
+};
+
+struct CorpusEntry
+{
+  Plan plan{};
+  Outcome outcome{};
+};
+
+struct SearchState
+{
+  bool armed = true;
+  bool capture_requested = false;
+  bool snapshot_ready = false;
+  bool restore_requested = false;
+  bool active = false;
+  bool finished = false;
+  bool found = false;
+  bool validation_done = false;
+  bool calibration_built = false;
+  bool adaptive_started = false;
+  u64 attempts = 0;
+  u64 rng_state = FUZZ_SEED;
+  std::vector<u8> snapshot;
+  std::deque<Plan> queue;
+  Plan current_plan{};
+  Outcome current_outcome{};
+  std::vector<Outcome> validation_outcomes;
+  std::vector<CorpusEntry> corpus;
+  std::vector<CorpusEntry> route_corpus;
+  std::set<std::tuple<bool, u16, bool, u16, bool, u32>> seen_signatures;
+  std::set<u16> seen_gate_seeds;
+  std::set<u16> seen_route_seeds;
+  std::set<u32> seen_final_ids;
+  std::set<std::string> known_plan_labels;
+  std::map<u16, size_t> gate_alias_counts;
+  std::map<u16, size_t> route_alias_counts;
+  float previous_speed = 1.0f;
+  std::chrono::steady_clock::time_point search_start{};
+  std::chrono::steady_clock::time_point attempt_start{};
+  std::ofstream results;
+};
+
+std::mutex s_mutex;
+std::atomic_bool s_suppress_trace{false};
+SearchState s_state;
+
+std::string KindName(const Mutation& mutation)
+{
+  switch (mutation.kind)
+  {
+  case MutationKind::BOff:
+    return "B_OFF";
+  case MutationKind::LOn:
+    return "L";
+  case MutationKind::ROn:
+    return "R";
+  case MutationKind::StickXDelta:
+    return fmt::format("SX{}{}", mutation.amount < 0 ? "m" : "p",
+                       std::abs(mutation.amount));
+  case MutationKind::StickYDelta:
+    return fmt::format("SY{}{}", mutation.amount < 0 ? "m" : "p",
+                       std::abs(mutation.amount));
+  case MutationKind::StickXCenter:
+    return "SX_CENTER";
+  case MutationKind::StickYCenter:
+    return "SY_CENTER";
+  }
+  return "?";
+}
+
+std::string MutationName(const Mutation& mutation)
+{
+  return fmt::format("F{}:{}{}", mutation.slot, KindName(mutation),
+                     mutation.duration > 1 ? fmt::format("x{}", mutation.duration) : "");
+}
+
+std::string MakePlanLabel(const std::vector<Mutation>& mutations)
+{
+  if (mutations.empty())
+    return "BASELINE";
+
+  std::string label;
+  for (const Mutation& mutation : mutations)
+  {
+    if (!label.empty())
+      label += '+';
+    label += MutationName(mutation);
+  }
+  return label;
+}
+
+enum class ControlGroup : u8
+{
+  B,
+  L,
+  R,
+  StickX,
+  StickY,
+};
+
+ControlGroup GetControlGroup(MutationKind kind)
+{
+  switch (kind)
+  {
+  case MutationKind::BOff:
+    return ControlGroup::B;
+  case MutationKind::LOn:
+    return ControlGroup::L;
+  case MutationKind::ROn:
+    return ControlGroup::R;
+  case MutationKind::StickXDelta:
+  case MutationKind::StickXCenter:
+    return ControlGroup::StickX;
+  case MutationKind::StickYDelta:
+  case MutationKind::StickYCenter:
+    return ControlGroup::StickY;
+  }
+  return ControlGroup::B;
+}
+
+u16 LastSlot(const Mutation& mutation)
+{
+  return static_cast<u16>(mutation.slot + 2 * (mutation.duration - 1));
+}
+
+bool Compatible(const Mutation& a, const Mutation& b)
+{
+  if (GetControlGroup(a.kind) != GetControlGroup(b.kind))
+    return true;
+  return LastSlot(a) < b.slot || LastSlot(b) < a.slot;
+}
+
+void NormalizePlan(Plan& plan)
+{
+  for (Mutation& mutation : plan.mutations)
+  {
+    int slot = std::clamp<int>(mutation.slot, WINDOW_FIRST, WINDOW_LAST);
+    slot -= (slot - static_cast<int>(WINDOW_FIRST)) & 1;
+    mutation.slot = static_cast<u16>(slot);
+    const u8 available = static_cast<u8>((WINDOW_LAST - mutation.slot) / 2 + 1);
+    mutation.duration = std::clamp<u8>(mutation.duration, 1, std::min(MAX_HOLD_SLOTS, available));
+
+    if (mutation.kind == MutationKind::StickXDelta ||
+        mutation.kind == MutationKind::StickYDelta)
+    {
+      if (mutation.amount == 0)
+        mutation.amount = 32;
+      mutation.amount = std::clamp(mutation.amount, -127, 127);
+    }
+    else
+    {
+      mutation.amount = 0;
+    }
+  }
+
+  std::ranges::sort(plan.mutations, [](const Mutation& a, const Mutation& b) {
+    return std::tie(a.slot, a.kind, a.duration, a.amount) <
+           std::tie(b.slot, b.kind, b.duration, b.amount);
+  });
+
+  std::vector<Mutation> normalized;
+  normalized.reserve(std::min(plan.mutations.size(), MAX_PLAN_MUTATIONS));
+  for (const Mutation& mutation : plan.mutations)
+  {
+    const bool compatible = std::ranges::all_of(
+        normalized, [&](const Mutation& existing) { return Compatible(existing, mutation); });
+    if (compatible)
+      normalized.push_back(mutation);
+    if (normalized.size() >= MAX_PLAN_MUTATIONS)
+      break;
+  }
+  plan.mutations = std::move(normalized);
+  plan.label = MakePlanLabel(plan.mutations);
+}
+
+Mutation MakeMutation(u16 slot, MutationKind kind, u8 duration = 1, int amount = 0)
+{
+  return Mutation{slot, duration, kind, amount};
+}
+
+Plan MakePlan(int phase, std::initializer_list<Mutation> mutations)
+{
+  Plan plan;
+  plan.phase = phase;
+  plan.mutations.assign(mutations.begin(), mutations.end());
+  NormalizePlan(plan);
+  return plan;
+}
+
+Plan MakePlan(int phase, std::vector<Mutation> mutations)
+{
+  Plan plan;
+  plan.phase = phase;
+  plan.mutations = std::move(mutations);
+  NormalizePlan(plan);
+  return plan;
+}
+
+bool IsFrameInMutation(u64 frame, const Mutation& mutation)
+{
+  // The RE4 movie edits used by the TAS are 30-fps slots represented by two emulated frames.
+  // A one-slot mutation at 2866 therefore covers emulated frames 2865 and 2866.
+  const u64 first_frame = mutation.slot - 1;
+  const u64 last_frame = LastSlot(mutation);
+  return frame >= first_frame && frame <= last_frame;
+}
+
+u8 AddClamped(u8 value, int delta)
+{
+  return static_cast<u8>(std::clamp(static_cast<int>(value) + delta, 0, 255));
+}
+
+void ApplyMutation(Movie::ControllerState& state, const Mutation& mutation)
+{
+  switch (mutation.kind)
+  {
+  case MutationKind::BOff:
+    state.B = false;
+    break;
+  case MutationKind::LOn:
+    state.L = true;
+    state.TriggerL = 255;
+    break;
+  case MutationKind::ROn:
+    state.R = true;
+    state.TriggerR = 255;
+    break;
+  case MutationKind::StickXDelta:
+    state.AnalogStickX = AddClamped(state.AnalogStickX, mutation.amount);
+    break;
+  case MutationKind::StickYDelta:
+    state.AnalogStickY = AddClamped(state.AnalogStickY, mutation.amount);
+    break;
+  case MutationKind::StickXCenter:
+    state.AnalogStickX = 128;
+    break;
+  case MutationKind::StickYCenter:
+    state.AnalogStickY = 128;
+    break;
+  }
+}
+
+void OpenResultsLocked()
+{
+  File::CreateFullPath(File::GetUserPath(D_LOGS_IDX));
+  const std::string path = File::GetUserPath(D_LOGS_IDX) + std::string(RESULTS_FILENAME);
+  s_state.results = std::ofstream(path, std::ios::out | std::ios::trunc);
+  if (s_state.results)
+  {
+    s_state.results << "attempt,phase,plan,parent,mutations,gate_seen,gate_seed,novel_gate,"
+                       "route_seen,route_seed,novel_route,final_seen,final_id,target,"
+                       "novel_signature,corpus_size,route_corpus_size,status,elapsed_ms\n";
+    s_state.results.flush();
+  }
+}
+
+void WriteResultLocked(const Plan& plan, const Outcome& outcome, double elapsed_ms)
+{
+  if (!s_state.results)
+    return;
+  s_state.results << fmt::format(
+      "{},{},{},{},{},{},${:04X},{},{},${:04X},{},{},${:08X},{},{},{},{},{},{:.3f}\n",
+      s_state.attempts, plan.phase, plan.label, plan.parent_label, plan.mutations.size(),
+      outcome.gate_seen ? 1 : 0, outcome.gate_seed, outcome.novel_gate ? 1 : 0,
+      outcome.route_seen ? 1 : 0, outcome.route_seed, outcome.novel_route ? 1 : 0,
+      outcome.final_seen ? 1 : 0, outcome.final_id, outcome.target ? 1 : 0,
+      outcome.novel_signature ? 1 : 0, s_state.corpus.size(), s_state.route_corpus.size(),
+      outcome.status, elapsed_ms);
+  s_state.results.flush();
+}
+
+void WriteFoundLocked()
+{
+  File::CreateFullPath(File::GetUserPath(D_LOGS_IDX));
+  const std::string path = File::GetUserPath(D_LOGS_IDX) + std::string(FOUND_FILENAME);
+  std::ofstream out(path, std::ios::out | std::ios::trunc);
+  if (!out)
+    return;
+  out << "RE4 JPN RNG SEARCH TARGET FOUND\n";
+  out << "Searcher: v5 coverage-guided\n";
+  out << fmt::format("Attempt: {}\n", s_state.attempts);
+  out << fmt::format("Plan: {}\n", s_state.current_plan.label);
+  out << fmt::format("Parent: {}\n", s_state.current_plan.parent_label);
+  out << fmt::format("Gate: ${:04X}\n", s_state.current_outcome.gate_seed);
+  out << fmt::format("Route: ${:04X}\n", s_state.current_outcome.route_seed);
+  out << fmt::format("Final ID: ${:08X}\n", s_state.current_outcome.final_id);
+}
