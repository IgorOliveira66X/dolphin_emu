+
+void BuildValidationQueueLocked()
+{
+  auto queue_unique = [](Plan plan) {
+    if (s_state.known_plan_labels.insert(plan.label).second)
+      s_state.queue.push_back(std::move(plan));
+  };
+  queue_unique(MakePlan(0, std::initializer_list<Mutation>{}));
+  queue_unique(MakePlan(0, {MakeMutation(2866, MutationKind::BOff)}));
+  queue_unique(MakePlan(0, {MakeMutation(2864, MutationKind::LOn),
+                            MakeMutation(2866, MutationKind::LOn)}));
+}
+
+bool QueueUniqueLocked(Plan plan)
+{
+  NormalizePlan(plan);
+  if (!s_state.known_plan_labels.insert(plan.label).second)
+    return false;
+  s_state.queue.push_back(std::move(plan));
+  return true;
+}
+
+void BuildCalibrationQueueLocked()
+{
+  // Exact plans recovered from the v4 CSV. They are deliberately tested first so both known
+  // grenade routes become high-energy parents before adaptive fuzzing starts.
+  const std::vector<std::vector<Mutation>> known_c085_plans = {
+      {MakeMutation(2822, MutationKind::LOn), MakeMutation(2842, MutationKind::ROn),
+       MakeMutation(2844, MutationKind::LOn)},
+      {MakeMutation(2822, MutationKind::ROn), MakeMutation(2842, MutationKind::ROn),
+       MakeMutation(2844, MutationKind::LOn)},
+      {MakeMutation(2824, MutationKind::LOn), MakeMutation(2842, MutationKind::ROn),
+       MakeMutation(2844, MutationKind::LOn)},
+      {MakeMutation(2824, MutationKind::ROn), MakeMutation(2842, MutationKind::ROn),
+       MakeMutation(2844, MutationKind::LOn)},
+      {MakeMutation(2826, MutationKind::LOn), MakeMutation(2842, MutationKind::ROn),
+       MakeMutation(2844, MutationKind::LOn)},
+      {MakeMutation(2826, MutationKind::ROn), MakeMutation(2842, MutationKind::ROn),
+       MakeMutation(2844, MutationKind::LOn)},
+  };
+  for (const auto& mutations : known_c085_plans)
+  {
+    Plan plan = MakePlan(1, mutations);
+    plan.parent_label = "V4_C085";
+    QueueUniqueLocked(std::move(plan));
+  }
+
+  struct Probe
+  {
+    MutationKind kind;
+    u8 duration;
+    int amount;
+  };
+  static constexpr Probe probes[] = {
+      {MutationKind::BOff, 1, 0},       {MutationKind::BOff, 2, 0},
+      {MutationKind::BOff, 4, 0},       {MutationKind::LOn, 1, 0},
+      {MutationKind::LOn, 2, 0},        {MutationKind::LOn, 4, 0},
+      {MutationKind::ROn, 1, 0},        {MutationKind::ROn, 2, 0},
+      {MutationKind::ROn, 4, 0},        {MutationKind::StickXDelta, 1, -96},
+      {MutationKind::StickXDelta, 1, -64}, {MutationKind::StickXDelta, 1, -32},
+      {MutationKind::StickXDelta, 1, 32},  {MutationKind::StickXDelta, 1, 64},
+      {MutationKind::StickXDelta, 1, 96},  {MutationKind::StickYDelta, 1, -96},
+      {MutationKind::StickYDelta, 1, -64}, {MutationKind::StickYDelta, 1, -32},
+      {MutationKind::StickYDelta, 1, 32},  {MutationKind::StickYDelta, 1, 64},
+      {MutationKind::StickYDelta, 1, 96},  {MutationKind::StickXCenter, 1, 0},
+      {MutationKind::StickXCenter, 2, 0},  {MutationKind::StickYCenter, 1, 0},
+      {MutationKind::StickYCenter, 2, 0},
+  };
+
+  for (u16 slot = WINDOW_FIRST; slot <= WINDOW_LAST; slot += 2)
+  {
+    for (const Probe& probe : probes)
+      QueueUniqueLocked(MakePlan(
+          1, {MakeMutation(slot, probe.kind, probe.duration, probe.amount)}));
+  }
+  s_state.calibration_built = true;
+}
+
+std::tuple<bool, u16, bool, u16, bool, u32> Signature(const Outcome& outcome)
+{
+  return {outcome.gate_seen, outcome.gate_seed, outcome.route_seen, outcome.route_seed,
+          outcome.final_seen, outcome.final_id};
+}
+
+void RecordCoverageLocked(const Plan& plan, Outcome& outcome)
+{
+  if (outcome.gate_seen)
+    outcome.novel_gate = s_state.seen_gate_seeds.insert(outcome.gate_seed).second;
+  if (outcome.route_seen)
+    outcome.novel_route = s_state.seen_route_seeds.insert(outcome.route_seed).second;
+  if (outcome.final_seen)
+    s_state.seen_final_ids.insert(outcome.final_id);
+  outcome.novel_signature = s_state.seen_signatures.insert(Signature(outcome)).second;
+
+  bool add_to_corpus = s_state.corpus.empty() || outcome.novel_signature;
+  if (outcome.gate_seen && outcome.gate_seed != EXPECTED_BASELINE_GATE &&
+      s_state.gate_alias_counts[outcome.gate_seed] < MAX_GATE_ALIASES)
+  {
+    add_to_corpus = true;
+  }
+  if (outcome.route_seen && s_state.route_alias_counts[outcome.route_seed] < MAX_ROUTE_ALIASES)
+    add_to_corpus = true;
+
+  if (add_to_corpus && s_state.corpus.size() < MAX_CORPUS_ENTRIES)
+  {
+    s_state.corpus.push_back({plan, outcome});
+    if (outcome.gate_seen && outcome.gate_seed != EXPECTED_BASELINE_GATE)
+      ++s_state.gate_alias_counts[outcome.gate_seed];
+  }
+
+  if (outcome.route_seen && s_state.route_alias_counts[outcome.route_seed] < MAX_ROUTE_ALIASES)
+  {
+    s_state.route_corpus.push_back({plan, outcome});
+    ++s_state.route_alias_counts[outcome.route_seed];
+  }
+}
+
+u64 NextRandomLocked()
+{
+  u64 x = s_state.rng_state;
+  x ^= x >> 12;
+  x ^= x << 25;
+  x ^= x >> 27;
+  s_state.rng_state = x;
+  return x * 0x2545F4914F6CDD1DULL;
+}
+
+size_t RandomIndexLocked(size_t count)
+{
+  return count == 0 ? 0 : static_cast<size_t>(NextRandomLocked() % count);
+}
+
+bool ChanceLocked(u32 percent)
+{
+  return RandomIndexLocked(100) < percent;
+}
+
+u8 RandomDurationLocked()
+{
+  const size_t roll = RandomIndexLocked(100);
+  if (roll < 45)
+    return 1;
+  if (roll < 70)
+    return 2;
+  if (roll < 85)
+    return 3;
+  if (roll < 95)
+    return 4;
+  return 6;
+}
+
+u16 RandomSlotLocked(const Plan* local_parent)
+{
+  static constexpr u16 hotspots[] = {2822, 2842, 2844, 2846, 2850, 2854, 2858,
+                                     2864, 2866, 2870, 2880, 2886, 2892, 2900, 2908};
+  int slot = 0;
+  if (local_parent && !local_parent->mutations.empty() && ChanceLocked(60))
+  {
+    const Mutation& anchor =
+        local_parent->mutations[RandomIndexLocked(local_parent->mutations.size())];
+    slot = static_cast<int>(anchor.slot) + (static_cast<int>(RandomIndexLocked(9)) - 4) * 2;
+  }
+  else if (ChanceLocked(40))
+  {
+    slot = hotspots[RandomIndexLocked(std::size(hotspots))];
+  }
+  else
+  {
+    slot = static_cast<int>(
+        WINDOW_FIRST + 2 * RandomIndexLocked((WINDOW_LAST - WINDOW_FIRST) / 2 + 1));
+  }
+  return static_cast<u16>(std::clamp<int>(slot, WINDOW_FIRST, WINDOW_LAST));
+}
+
+Mutation RandomMutationLocked(const Plan* local_parent)
+{
+  static constexpr MutationKind weighted_kinds[] = {
+      MutationKind::BOff,        MutationKind::BOff,       MutationKind::LOn,
+      MutationKind::LOn,         MutationKind::ROn,        MutationKind::ROn,
+      MutationKind::StickXDelta, MutationKind::StickXDelta, MutationKind::StickYDelta,
+      MutationKind::StickYDelta, MutationKind::StickYDelta, MutationKind::StickXCenter,
+      MutationKind::StickYCenter, MutationKind::StickYCenter};
+  static constexpr int analog_amounts[] = {-96, -64, -32, -16, 16, 32, 64, 96};
+
+  const MutationKind kind = weighted_kinds[RandomIndexLocked(std::size(weighted_kinds))];
+  const int amount = kind == MutationKind::StickXDelta || kind == MutationKind::StickYDelta ?
+                         analog_amounts[RandomIndexLocked(std::size(analog_amounts))] :
+                         0;
+  return MakeMutation(RandomSlotLocked(local_parent), kind, RandomDurationLocked(), amount);
+}
+
+bool AddRandomMutationLocked(Plan& plan, const Plan* local_parent)
+{
+  if (plan.mutations.size() >= MAX_PLAN_MUTATIONS)
+    return false;
+  for (int attempt = 0; attempt < 32; ++attempt)
+  {
+    const Mutation mutation = RandomMutationLocked(local_parent);
+    if (std::ranges::all_of(plan.mutations, [&](const Mutation& existing) {
+          return Compatible(existing, mutation);
+        }))
+    {
+      plan.mutations.push_back(mutation);
+      return true;
+    }
+  }
+  return false;
+}
+
+Plan SelectRouteParentLocked()
+{
+  if (s_state.route_corpus.empty())
+    return MakePlan(2, std::initializer_list<Mutation>{});
+
+  const size_t seed_index = RandomIndexLocked(s_state.seen_route_seeds.size());
+  auto seed_it = s_state.seen_route_seeds.begin();
+  for (size_t i = 0; i < seed_index; ++i)
+    ++seed_it;
+  const u16 selected_seed = *seed_it;
+
+  size_t matching = 0;
+  for (const CorpusEntry& entry : s_state.route_corpus)
+  {
+    if (entry.outcome.route_seed == selected_seed)
+      ++matching;
+  }
+  size_t selected = RandomIndexLocked(matching);
+  for (const CorpusEntry& entry : s_state.route_corpus)
+  {
+    if (entry.outcome.route_seed == selected_seed && selected-- == 0)
+      return entry.plan;
+  }
+  return s_state.route_corpus.front().plan;
+}
+
+Plan SelectParentLocked()
+{
+  if (!s_state.route_corpus.empty() && ChanceLocked(45))
+    return SelectRouteParentLocked();
+  if (!s_state.corpus.empty() && ChanceLocked(90))
+    return s_state.corpus[RandomIndexLocked(s_state.corpus.size())].plan;
+  return MakePlan(2, std::initializer_list<Mutation>{});
+}
+
+void EditPlanLocked(Plan& plan)
+{
+  if (plan.mutations.empty())
+  {
+    AddRandomMutationLocked(plan, &plan);
+    return;
+  }
+
+  Mutation& mutation = plan.mutations[RandomIndexLocked(plan.mutations.size())];
+  switch (RandomIndexLocked(4))
+  {
+  case 0:
+    mutation.slot = RandomSlotLocked(&plan);
+    break;
+  case 1:
+    mutation.duration = RandomDurationLocked();
+    break;
+  case 2:
+  {
+    const Mutation replacement = RandomMutationLocked(&plan);
+    mutation.kind = replacement.kind;
+    mutation.amount = replacement.amount;
+    break;
+  }
+  case 3:
+    if (mutation.kind == MutationKind::StickXDelta ||
+        mutation.kind == MutationKind::StickYDelta)
+      mutation.amount = -mutation.amount;
+    else
+      mutation.duration = static_cast<u8>(1 + RandomIndexLocked(MAX_HOLD_SLOTS));
+    break;
+  }
+  NormalizePlan(plan);
+}
+
+void SplicePlanLocked(Plan& plan)
+{
+  if (s_state.corpus.empty())
+  {
+    AddRandomMutationLocked(plan, &plan);
+    return;
+  }
+  const Plan* other = nullptr;
+  for (int attempt = 0; attempt < 16 && !other; ++attempt)
+  {
+    const Plan& candidate = s_state.corpus[RandomIndexLocked(s_state.corpus.size())].plan;
+    if (!candidate.mutations.empty())
+      other = &candidate;
+  }
+  if (!other)
+  {
+    AddRandomMutationLocked(plan, &plan);
+    return;
+  }
+  const size_t additions = 1 + RandomIndexLocked(std::min<size_t>(3, other->mutations.size()));
+  for (size_t i = 0; i < additions && plan.mutations.size() < MAX_PLAN_MUTATIONS; ++i)
+    plan.mutations.push_back(other->mutations[RandomIndexLocked(other->mutations.size())]);
+  NormalizePlan(plan);
+}
+
+bool BuildNextAdaptivePlanLocked()
+{
+  for (int generation_attempt = 0; generation_attempt < 512; ++generation_attempt)
+  {
+    Plan parent = SelectParentLocked();
+    Plan candidate = parent;
+    candidate.phase = 2;
+    candidate.parent_label = parent.label;
+    const size_t operation = RandomIndexLocked(100);
+
+    if (operation < 15)
+    {
+      candidate.mutations.clear();
+      candidate.parent_label = "FRESH";
+      const size_t count = 1 + RandomIndexLocked(6);
+      for (size_t i = 0; i < count; ++i)
+        AddRandomMutationLocked(candidate, &candidate);
+    }
+    else if (operation < 55)
+    {
+      AddRandomMutationLocked(candidate, &parent);
+      if (ChanceLocked(20))
+        AddRandomMutationLocked(candidate, &parent);
+    }
+    else if (operation < 75)
+    {
+      EditPlanLocked(candidate);
+    }
+    else if (operation < 85)
+    {
+      if (!candidate.mutations.empty())
+        candidate.mutations.erase(candidate.mutations.begin() +
+                                  RandomIndexLocked(candidate.mutations.size()));
+    }
+    else
+    {
+      SplicePlanLocked(candidate);
+    }
+
+    if (candidate.mutations.empty())
+      AddRandomMutationLocked(candidate, &parent);
+    NormalizePlan(candidate);
+    if (!candidate.mutations.empty() &&
+        !s_state.known_plan_labels.contains(candidate.label))
+    {
+      return QueueUniqueLocked(std::move(candidate));
+    }
+  }
+  return false;
+}
+
+bool ValidationPassedLocked()
+{
+  if (s_state.validation_outcomes.size() != 3)
+    return false;
+  const Outcome& baseline = s_state.validation_outcomes[0];
+  const Outcome& b2866 = s_state.validation_outcomes[1];
+  const Outcome& lpair = s_state.validation_outcomes[2];
+  return baseline.gate_seen && baseline.gate_seed == EXPECTED_BASELINE_GATE &&
+         b2866.gate_seen && b2866.gate_seed == EXPECTED_B2866_GATE && lpair.gate_seen &&
+         lpair.gate_seed == EXPECTED_LPAIR_GATE && lpair.route_seen &&
+         lpair.route_seed == EXPECTED_LPAIR_ROUTE && lpair.final_seen &&
+         lpair.final_id == EXPECTED_LPAIR_ID;
+}
+
+bool PrepareNextPlanLocked()
+{
+  if (s_state.attempts >= BUDGET)
+    return false;
+
+  if (s_state.queue.empty() && !s_state.validation_done)
+  {
+    if (!ValidationPassedLocked())
+      return false;
+    s_state.validation_done = true;
+    OSD::AddTypedMessage(OSD::MessageType::RE4RNGTrace,
+                         "RE4 SEARCH validation PASSED | automatic input edits are synced",
+                         OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+    BuildCalibrationQueueLocked();
+  }
+
+  if (s_state.queue.empty() && s_state.validation_done && s_state.calibration_built)
+  {
+    s_state.adaptive_started = true;
+    if (!BuildNextAdaptivePlanLocked())
+      return false;
+  }
+
+  if (s_state.queue.empty())
+    return false;
+
+  s_state.current_plan = std::move(s_state.queue.front());
+  s_state.queue.pop_front();
+  s_state.current_outcome = Outcome{};
+  s_state.attempt_start = std::chrono::steady_clock::now();
+  return true;
+}
+
+void FinishSearchLocked(System* system, std::string_view message, u32 color)
+{
+  s_state.finished = true;
+  s_state.active = false;
+  s_suppress_trace.store(false, std::memory_order_release);
+  Config::SetCurrent(Config::MAIN_EMULATION_SPEED, s_state.previous_speed);
+  if (s_state.results)
+    s_state.results.flush();
+  WriteSummaryLocked(message);
+  OSD::AddTypedMessage(OSD::MessageType::RE4RNGTrace, std::string(message),
+                       OSD::Duration::VERY_LONG, color);
+  if (system)
+    system->GetCPU().Break();
+}
+
+void CaptureOnCPUThread(System* system)
+{
+  auto snapshot = ::State::SaveToMemory(*system);
+  {
+    std::lock_guard lock{s_mutex};
+    if (snapshot.empty())
+    {
+      FinishSearchLocked(system, "RE4 SEARCH FAILED: in-memory snapshot error", OSD::Color::RED);
+      return;
+    }
+
+    s_state.snapshot = std::move(snapshot);
+    s_state.snapshot_ready = true;
+    s_state.active = true;
+    s_state.previous_speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+    Config::SetCurrent(Config::MAIN_EMULATION_SPEED, 0.0f);
+    s_suppress_trace.store(true, std::memory_order_release);
+    OpenResultsLocked();
+    BuildValidationQueueLocked();
+    PrepareNextPlanLocked();
+    s_state.search_start = std::chrono::steady_clock::now();
+
+    OSD::AddTypedMessage(
+        OSD::MessageType::RE4RNGTrace,
+        fmt::format("RE4 RNG SEARCH v5 START | F{} snapshot {:.1f} MiB | budget {}", CAPTURE_FRAME,
+                    static_cast<double>(s_state.snapshot.size()) / (1024.0 * 1024.0), BUDGET),
+        OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+  }
+  system->GetCPU().Continue();
+}
+
+void RestoreOnCPUThread(System* system)
+{
+  std::span<u8> snapshot;
+  {
+    std::lock_guard lock{s_mutex};
+    snapshot = std::span<u8>{s_state.snapshot};
+  }
+
+  const bool ok = ::State::LoadFromMemory(*system, snapshot);
+  {
+    std::lock_guard lock{s_mutex};
+    s_state.restore_requested = false;
+    if (!ok)
+    {
+      FinishSearchLocked(system, "RE4 SEARCH FAILED: in-memory restore error", OSD::Color::RED);
+      return;
+    }
+
+    if (!PrepareNextPlanLocked())
+    {
+      if (!s_state.validation_done)
+      {
+        FinishSearchLocked(system,
+                           "RE4 SEARCH validation FAILED | inspect re4_jpn_rng_search_results.csv",
+                           OSD::Color::RED);
+      }
+      else
+      {
+        FinishSearchLocked(
+            system,
+            fmt::format("RE4 SEARCH DONE | {} attempts | {} gate seeds | {} route seeds",
+                        s_state.attempts, s_state.seen_gate_seeds.size(),
+                        s_state.seen_route_seeds.size()),
+            OSD::Color::YELLOW);
+      }
+      return;
+    }
+  }
+  system->GetCPU().Continue();
+}
+
+void CompleteAttempt(System* system, std::string status)
+{
+  bool found = false;
+  bool request_restore = false;
+  u64 attempts = 0;
+  double rate = 0.0;
+  std::string found_plan;
+
+  {
+    std::lock_guard lock{s_mutex};
+    if (!s_state.active || s_state.finished || s_state.restore_requested)
+      return;
+
+    s_state.current_outcome.status = std::move(status);
+    ++s_state.attempts;
+    const double elapsed_ms = std::chrono::duration<double, std::milli>(
+                                  std::chrono::steady_clock::now() - s_state.attempt_start)
+                                  .count();
+    RecordCoverageLocked(s_state.current_plan, s_state.current_outcome);
+    WriteResultLocked(s_state.current_plan, s_state.current_outcome, elapsed_ms);
+
+    if (!s_state.validation_done)
+      s_state.validation_outcomes.push_back(s_state.current_outcome);
+
+    if (s_state.current_outcome.target)
+    {
+      s_state.found = true;
+      found = true;
+      WriteFoundLocked();
+      found_plan = s_state.current_plan.label;
+    }
+    else
+    {
+      s_state.restore_requested = true;
+      request_restore = true;
+    }
+
+    attempts = s_state.attempts;
+    const double seconds =
+        std::chrono::duration<double>(std::chrono::steady_clock::now() - s_state.search_start)
+            .count();
+    rate = seconds > 0.0 ? static_cast<double>(attempts) / seconds : 0.0;
+
+    if (s_state.current_outcome.novel_route)
+    {
+      OSD::AddTypedMessage(
+          OSD::MessageType::RE4RNGTrace,
+          fmt::format("RE4 NEW ROUTE ${:04X} | attempt {} | {} total",
+                      s_state.current_outcome.route_seed, attempts,
+                      s_state.seen_route_seeds.size()),
+          OSD::Duration::VERY_LONG,
+          s_state.current_outcome.route_seed == KNOWN_HAND_ROUTE ? OSD::Color::GREEN :
+                                                                  OSD::Color::CYAN);
+    }
+
+    if ((attempts % 50) == 0)
+    {
+      OSD::AddTypedMessage(
+          OSD::MessageType::RE4RNGTrace,
+          fmt::format("RE4 SEARCH | {} | {:.2f}/s | phase {} | corpus {} | gates {} | routes {}",
+                      attempts, rate, s_state.current_plan.phase, s_state.corpus.size(),
+                      s_state.seen_gate_seeds.size(), s_state.seen_route_seeds.size()),
+          OSD::Duration::VERY_LONG, OSD::Color::CYAN);
+    }
+  }
+
+  if (found)
+  {
+    std::lock_guard lock{s_mutex};
+    FinishSearchLocked(
+        system, fmt::format("RE4 SEARCH TARGET FOUND | attempt {} | {}", attempts, found_plan),
+        OSD::Color::GREEN);
+    return;
+  }
+
+  if (request_restore)
+  {
+    system->GetCPU().AddCPUThreadJob([system] { RestoreOnCPUThread(system); });
+    system->GetCPU().Break();
+  }
+}
+}  // namespace
+
+void ResetSession()
+{
+  std::lock_guard lock{s_mutex};
+  if (s_state.results.is_open())
+    s_state.results.close();
+  s_state = SearchState{};
+  s_suppress_trace.store(false, std::memory_order_release);
+  OSD::AddTypedMessage(
+      OSD::MessageType::RE4RNGTrace,
+      fmt::format("RE4 RNG search v5 armed | capture F{} | window {}-{}", CAPTURE_FRAME,
+                  WINDOW_FIRST, WINDOW_LAST),
+      OSD::Duration::VERY_LONG, OSD::Color::GREEN);
+}
+
+void MutateMovieControllerState(u64 movie_frame, Movie::ControllerState& state)
+{
+  std::lock_guard lock{s_mutex};
+  if (!s_state.active || s_state.finished)
+    return;
+  for (const Mutation& mutation : s_state.current_plan.mutations)
+  {
+    if (IsFrameInMutation(movie_frame, mutation))
+      ApplyMutation(state, mutation);
+  }
+}
+
+void OnPadPoll(u64 movie_frame)
+{
+  bool request_capture = false;
+  bool close_attempt = false;
+  std::string close_status;
+  {
+    std::lock_guard lock{s_mutex};
+    if (s_state.armed && !s_state.capture_requested && !s_state.snapshot_ready &&
+        !s_state.finished && movie_frame >= CAPTURE_FRAME)
+    {
+      s_state.capture_requested = true;
+      request_capture = true;
+    }
+    else if (s_state.active && !s_state.restore_requested && !s_state.finished)
+    {
+      if (s_state.current_outcome.gate_seen && movie_frame >= RESULT_FRAME)
+      {
+        close_attempt = true;
+        close_status = "complete";
+      }
+      else if (movie_frame >= HARD_END_FRAME)
+      {
+        close_attempt = true;
+        close_status = s_state.current_outcome.gate_seen ? "late_complete" : "no_gate";
+      }
+    }
+  }
+
+  System* const system = &System::GetInstance();
+  if (request_capture)
+  {
+    system->GetCPU().AddCPUThreadJob([system] { CaptureOnCPUThread(system); });
+    system->GetCPU().Break();
+  }
+  else if (close_attempt)
+  {
+    CompleteAttempt(system, std::move(close_status));
+  }
+}
+
+bool OnDropProbe(System* system, u32 pc)
+{
+  if (!system || !s_suppress_trace.load(std::memory_order_acquire))
+    return false;
+
+  bool complete_now = false;
+  bool target = false;
+  {
+    std::lock_guard lock{s_mutex};
+    if (!s_state.active || s_state.finished)
+      return true;
+
+    const u16 seed = system->GetMemory().Read_U16(RE4RNGTrace::RNG_STATE_ADDRESS);
+    if (pc == GATE_PC)
+    {
+      s_state.current_outcome.gate_seen = true;
+      s_state.current_outcome.gate_seed = seed;
+    }
+    else if (pc == ROUTE_PC)
+    {
+      s_state.current_outcome.route_seen = true;
+      s_state.current_outcome.route_seed = seed;
+    }
+    else if (pc == FINAL_ID_PC)
+    {
+      const auto& ppc_state = system->GetPowerPC().GetPPCState();
+      s_state.current_outcome.final_seen = true;
+      s_state.current_outcome.final_id = ppc_state.gpr[29];
+      s_state.current_outcome.target = ppc_state.gpr[29] == TARGET_ITEM_ID;
+      target = s_state.current_outcome.target;
+      complete_now = true;
+    }
+  }
+
+  if (complete_now)
+    CompleteAttempt(system, target ? "target" : "final_id");
+  return true;
+}
+
+bool IsSuppressingTrace()
+{
+  return s_suppress_trace.load(std::memory_order_acquire);
+}
+
+}  // namespace Core::RE4RNGSearch
